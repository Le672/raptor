{
  "name": "yukino-nations-d1-cleanup",
  "main": "d1-cleanup.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "triggers": {
    "crons": [
      "23 20 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yukino-portal",
      "database_id": "e069f104-f55e-441f-9907-0106e2100df7"
    },
    {
      "binding": "GAMES_DB",
      "database_name": "yukino-portal",
      "database_id": "e069f104-f55e-441f-9907-0106e2100df7"
    }
  ],
  "observability": {
    "enabled": true
  }
}
